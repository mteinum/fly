DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://fly.teinum.no%{REQUEST_URI} [R=301,L,NE]

  # Flisene ligger ferdig komprimert ved siden av originalen (.br og .gz, skrevet av bygget, se web/src/dataVersions.ts).
  # Brotli først, så gzip; finnes ingen av dem sendes originalen, og mod_deflate komprimerer som før.
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -s
  RewriteRule ^(data/.+\.(?:f32|bin|json))$ $1.br [L]
  RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
  RewriteCond %{REQUEST_FILENAME}.gz -s
  RewriteRule ^(data/.+\.(?:f32|bin|json))$ $1.gz [L]
  # Andre runde, på den omskrevne stien: riktig innholdstype, og ingen komprimering én gang til.
  # Må stå her og ikke på regelen over: variabler satt i første runde får forstavelsen REDIRECT_.
  RewriteRule ^data/.+\.json\.(?:br|gz)$ - [L,T=application/json,E=no-gzip:1,E=no-brotli:1]
  RewriteRule ^data/.+\.(?:f32|bin)\.(?:br|gz)$ - [L,T=application/octet-stream,E=no-gzip:1,E=no-brotli:1]
</IfModule>

# Delingssiden (share/) har en fellesfil som ikke skal åpnes direkte
<IfModule mod_authz_core.c>
  <Files "lib.php">
    Require all denied
  </Files>
</IfModule>

<IfModule mod_mime.c>
  # Fliser fra pipeline: rå Float32 og uint8
  AddType application/octet-stream .f32 .bin
  # Ferdig komprimerte fliser: .br og .gz er en koding av innholdet, ikke en egen filtype
  RemoveType .br .gz
  AddEncoding br .br
  AddEncoding gzip .gz
</IfModule>

# Det som ikke er komprimert på forhånd (html, js, css, og fliser uten .br/.gz) komprimeres her
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/octet-stream application/json text/html text/css application/javascript text/javascript
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # Vite legger innholds-hash i filnavnene under /assets/: de kan caches for alltid
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Bilder og lyd har faste navn og kan bli byttet ved neste publisering
  <FilesMatch "\.(png|jpg|mp3)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Fliser med versjon i adressen (?v=<hash>, satt av fileUrl i web/src/terrain.ts) endres aldri: nytt innhold
  # gir ny adresse. De kan caches for alltid. <If> leses etter <FilesMatch> og vinner over timen for png over.
  <FilesMatch "\.(json|f32|bin|png)(\.br|\.gz)?$">
    <If "%{QUERY_STRING} =~ /^v=[0-9a-f]{12}$/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  # Uten versjon (metadata.json, index.json, lydmanifestet): nettleseren spør alltid om fila er endret
  # (uendrede filer lastes ikke ned på nytt). Navn, kreditering og flisenes versjoner kommer fra metadata.
  <FilesMatch "\.(json|f32|bin)(\.br|\.gz)?$">
    <If "%{QUERY_STRING} !~ /^v=[0-9a-f]{12}$/">
      Header set Cache-Control "no-cache"
    </If>
    # Samme adresse gir ulikt innhold etter hva nettleseren tåler
    Header merge Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
